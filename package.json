{
  "name": "friendslop-fishing-co",
  "version": "1.0.0",
  "description": "Friendslop Fishing Co. — Chaotic Co-op Fishing & Secret Sabotage Game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/server.ts",
    "start": "tsx server/server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
